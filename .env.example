# ApexSIEM Environment Configuration
# Copy this file to .env and fill in your values

# JWT Secret Key - MUST be set to a strong random value in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-jwt-key-change-in-production

# Groq API Key for AI analysis (get free key at console.groq.com)
GROQ_API_KEY=your-groq-api-key

# Frontend origin for CORS (comma-separated for multiple)
FRONTEND_ORIGIN=http://localhost:5173

# Database URL (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///./siem.db

# Rate limiting configuration
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Disabled by default. If explicitly enabled, any generated development event
# must identify source_type=simulated and collector=AttackSimulator.
APEXSIEM_SIMULATION_MODE=false
